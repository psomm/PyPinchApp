# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Dependencies and local caches
.venv/
node_modules/
.pytest_cache/
.ruff_cache/
.flet/
.uv-cache/

# Test reports and diagnostic logs
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log

# Native build artifacts and signing keys
*.jks
*.keystore
*.apk
*.aab

# Local secrets and signing credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# Temporary browser profiles and knowledge-graph output
.chrome-screenshot-profile/
graphify-out/

# Shared VS Code tasks and launch configuration; other settings stay local
/.vscode/*
!/.vscode/launch.json
!/.vscode/tasks.json
.idea/

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# CSV output generated by the original PyPinch solver
ProblemTable.csv
