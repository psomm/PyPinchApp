{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PyPinch: Desktop debuggen",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "UV_CACHE_DIR": "${workspaceFolder}/.uv-cache"
      }
    }
  ]
}
